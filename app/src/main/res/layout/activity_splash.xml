<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#04150F">

    <!-- Fondo decorativo -->

    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="35dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#0B2B1F">

            <ImageView
                android:id="@+id/ivLogoSplash"
                android:layout_width="114dp"
                android:layout_height="106dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_app"
                app:tint="#10B981" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvAppNameSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="EcoResiduos"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tecnología para el planeta"
            android:textColor="#8EE4B6"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- Barra moderna -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        app:indicatorColor="#10B981"
        app:trackColor="#1E3A34"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
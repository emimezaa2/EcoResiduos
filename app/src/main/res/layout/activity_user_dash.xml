<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="32dp">

                <View
                    android:id="@+id/headerBackground"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@color/green_primary"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnOpenMenu"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/white"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:src="@drawable/ic_profile" app:tint="@color/green_primary"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bienvenido," android:textColor="#A7F3D0" android:textSize="14sp" />
                        <TextView android:id="@+id/tvUserNameDash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando..." android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="2dp">
                            <TextView android:id="@+id/tvUserTokensDash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="4dp"/>
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_token" app:tint="#FCD34D"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/tvUserPremiosDash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#A7F3D0" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="4dp"/>
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_premio_header" app:tint="#A7F3D0"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="12dp"
                    app:layout_constraintTop_toBottomOf="@id/topBar">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu Impacto Total" android:textColor="@color/text_sub" android:textStyle="bold" />
                        <TextView android:id="@+id/tvUserTotalKilos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 kg" android:textColor="@color/green_primary" android:textSize="36sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:gravity="center_vertical">
                            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:progress="100" android:progressTint="@color/green_light"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Nivel Activo" android:textColor="@color/text_dark" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTripleStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/cardSummary">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvStatRegistros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registros" android:textColor="@color/text_sub" android:textSize="12sp"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E2E8F0" android:layout_marginHorizontal="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvStatValidados" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/green_primary" android:textSize="18sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Validados" android:textColor="@color/text_sub" android:textSize="12sp"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E2E8F0" android:layout_marginHorizontal="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvStatComunidades" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#8B5CF6" android:textSize="18sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grupos" android:textColor="@color/text_sub" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:id="@+id/tvLabelActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="32dp" android:text="Acciones Principales" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/cardTripleStats" app:layout_constraintStart_toStartOf="parent"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/admin_dark"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelActions">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">
                        <com.google.android.material.card.MaterialCardView android:layout_width="48dp" android:layout_height="48dp" app:cardBackgroundColor="#334155" app:cardCornerRadius="12dp" app:strokeWidth="0dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:src="@drawable/ic_menu_reporte" app:tint="@color/white"/>
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nuevo Registro" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ingresar material al sistema" android:textColor="#94A3B8" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#8B5CF6"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@id/cardReporte">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardBackgroundColor="#6D28D9" app:cardCornerRadius="10dp" app:strokeWidth="0dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@android:drawable/ic_menu_camera" app:tint="@color/white"/>
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eco-Escáner IA" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clasifica basura con tu cámara" android:textColor="#DDD6FE" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/rowAtajos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/cardIA">

                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardImpacto" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeWidth="0dp" android:clickable="true" android:focusable="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_menu_impacto" app:tint="@color/green_primary"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Historial" android:textStyle="bold" android:textColor="@color/text_dark" android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardPuntos" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginStart="8dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeWidth="0dp" android:clickable="true" android:focusable="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_menu_puntos" app:tint="@color/green_primary"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red GPS" android:textStyle="bold" android:textColor="@color/text_dark" android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView android:id="@+id/tvLabelComunidad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="32dp" android:text="Comunidad y Beneficios" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/rowAtajos" app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelComunidad"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardComunidadDash"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardBackgroundColor="#E0F2FE"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chat_merged" app:tint="#0369A1"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mi Grupo" android:textStyle="bold" android:textColor="#0369A1" android:layout_marginTop="4dp" android:textSize="12sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardForoDash"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#E0F2FE"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chat_merged" app:tint="#0369A1"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Muro Social" android:textStyle="bold" android:textColor="#0369A1" android:layout_marginTop="4dp" android:textSize="12sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRecompensasDash"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardBackgroundColor="#FEF3C7"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_premio_header" app:tint="#92400E"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premios" android:textStyle="bold" android:textColor="#92400E" android:layout_marginTop="4dp" android:textSize="12sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEcoBot"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_menu_bot"
                    app:tint="@color/green_primary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/nav_menu_user"
        app:headerLayout="@layout/nav_header_user"
        app:itemIconTint="@color/green_primary"
        app:itemTextColor="@color/text_dark"/>

</androidx.drawerlayout.widget.DrawerLayout>
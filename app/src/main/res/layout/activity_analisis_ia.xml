<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"> <!-- Fondo oscuro tipo IA -->

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:id="@+id/topBarIA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBackIA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:paddingEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eco-Escáner con IA"
            android:textColor="#10B981"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- ÁREA DE LA IMAGEN -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFoto"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#1E293B"
        app:layout_constraintTop_toBottomOf="@id/topBarIA">

        <ImageView
            android:id="@+id/ivFotoBasura"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#475569" />

    </com.google.android.material.card.MaterialCardView>

    <!-- RESULTADOS DE LA IA -->
    <TextView
        android:id="@+id/tvResultadosIA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="Toma una foto de un residuo para que la Inteligencia Artificial lo clasifique automáticamente."
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/cardFoto" />

    <!-- BOTONES -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTomarFoto"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:text="Abrir Cámara"
        android:backgroundTint="#10B981"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnRegistrarIA" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegistrarIA"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:text="Registrar Impacto"
        android:textColor="#10B981"
        android:enabled="false"
        app:strokeColor="#10B981"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
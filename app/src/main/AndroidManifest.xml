<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.meza.ecoresiduos">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ecoresiduos">

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" /> <activity
        android:name=".auth.RegisterActivity"
        android:exported="false" />

        <activity
            android:name=".user.UserDashActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserReporteActivity"
            android:exported="false" />

        <activity
            android:name=".user.AnalisisIAActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserImpactoActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserEcobotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" /> <activity
        android:name=".user.UserPuntosActivity"
        android:exported="false" />

        <activity
            android:name=".user.SuscripcionActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserRecompensasActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserComunidadActivity"
            android:exported="false" />

        <activity
            android:name=".user.UserForoActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminDashActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminValidarActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminPuntosActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminBitacoraActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminComunidadActivity"
            android:exported="false" />

        <activity
            android:name=".user.CreadorValidarActivity"
            android:exported="false" />

    </application>

</manifest>